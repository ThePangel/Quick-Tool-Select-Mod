{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Allows for quick selection of an appropriate tool for the job just by holding the scroll wheel!",
  "authors": [
    {
      "name": "ThePangel",
      "contact": {
        "sources": "https://github.com/ThePangel"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/project/quick-tool-select/",
    "sources": "https://github.com/ThePangel/Quick-Tool-Select-Mod",
    "issues": "https://github.com/ThePangel/Quick-Tool-Select-Mod/issues"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/quicktoolselect/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "quicktoolselect.thepangel.QuickToolSelect"
    ],
    "modmenu": [
      "quicktoolselect.thepangel.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "quicktoolselect.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "${minecraft}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "yet_another_config_lib_v3": "${yacl}",
    "modmenu": "${modmenu}"
  }
}